{
  "package": "yoyo",
  "version": "1.5.0",
  "audience": "个人开发者及其AI Agent",
  "scope": "project-workspace-only",
  "entrypoint": "SKILL.md",
  "global_install_allowed": false,
  "project_install_targets": {
    "claude_code": ".claude/skills/yoyo",
    "codex": ".agents/skills/yoyo",
    "other": "officially_verified_project_scope_only"
  },
  "project_state_directory": ".yoyo",
  "modes": [
    "NEW_PROJECT",
    "PROJECT_TAKEOVER",
    "SECONDARY_DEVELOPMENT",
    "REFACTORING",
    "MAINTENANCE",
    "MIGRATION"
  ],
  "references": [
    "references/软件工程规范-通用复用版-增强版.md",
    "references/项目实施与持续验收规范-通用复用版-V1.0.md",
    "references/项目启动规范.md",
    "references/三端规范-通用复用版-V1.1-修订稿.md",
    "references/UI 设计质量与反模板化规范.md"
  ],
  "rules": [
    "NO_PATCH_STYLE_CHANGES",
    "SINGLE_SOURCE_OF_TRUTH",
    "AUTHORITATIVE_HASH_VERIFICATION",
    "ATOMIC_WRITE_FOR_USER_DATA",
    "UI_STATE_RECONCILIATION"
  ],
  "specification_dispatch": "core/specification-dispatch.md"
}
